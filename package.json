{
  "name": "q2fa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "contracts",
    "shared"
  ],
  "scripts": {
    "phase0": "tsx scripts/phase0-pq-mainnet.ts",
    "typecheck": "npm run typecheck:phase0 && npm run typecheck --workspaces --if-present",
    "typecheck:phase0": "tsc --noEmit -p tsconfig.json",
    "build": "npm run build --workspaces --if-present",
    "test:contracts": "npm run test --workspace=@q2fa/contracts",
    "test:backend": "npm run test --workspace=@q2fa/backend",
    "gas:contracts": "npm run gas --workspace=@q2fa/contracts",
    "check": "npm run typecheck && npm run build && npm run test:backend && npm run test:contracts"
  },
  "dependencies": {
    "@noble/post-quantum": "^0.7.1",
    "dotenv": "^16.6.1",
    "viem": "^2.38.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
